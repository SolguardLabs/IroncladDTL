{
  "name": "ironclad-dtl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motor determinista de compromisos de entrega, reservas y liquidacion por tramos.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format:check": "gofmt -l src | node scripts/assert-empty.mjs",
    "loc": "node scripts/check-loc.mjs",
    "test:go": "go test ./...",
    "test:node": "node --test --experimental-strip-types \"tests/node/*.test.ts\"",
    "test": "node scripts/build.mjs && npm run test:go && npm run test:node",
    "verify:public": "node scripts/verify-public.mjs",
    "ci": "node scripts/ci.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
